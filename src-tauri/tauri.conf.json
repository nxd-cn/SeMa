{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SeMa",
  "mainBinaryName": "SeMa",
  "version": "0.1.0",
  "identifier": "com.sema.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SeMa",
        "width": 1100,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "bundleName": "SeMa"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
